{
  "name": "kbrdn-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo de documentation multi-produits (Astro Starlight, Bun workspaces).",
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "bun --filter='@kbrdn/docs-gwm' run dev",
    "dev:gwm": "bun --filter='@kbrdn/docs-gwm' run dev",
    "build": "bun --filter='*' run build",
    "preview:gwm": "bun --filter='@kbrdn/docs-gwm' run preview",
    "check": "bun run lint && bun run format:check && bun --filter='*' run check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2"
  }
}
